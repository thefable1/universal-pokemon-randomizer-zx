{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-ui",
  "version": "0.1.0",
  "identifier": "com.dabomstew.uprzx",
  "build": {
    "beforeDevCommand": "pnpm prep:bridge && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm prep:bridge && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Pok\u00e9mon Randomizer ZX",
        "width": 1000,
        "height": 760,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/jre": "jre",
      "resources/web-bridge.jar": "web-bridge.jar"
    }
  }
}